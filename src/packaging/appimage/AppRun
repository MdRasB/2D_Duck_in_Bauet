#!/bin/bash
# AppRun — DuckDash AppImage entry point.
#
# Deliberately does no environment juggling: DuckDash does not bundle a
# private GStreamer/FFmpeg, so there is nothing to point the JVM at.
# JavaFX's media module finds and uses whatever GStreamer 1.x plugins the
# host system already has installed — the standard, documented way OpenJFX
# Media works on Linux. See the README "Linux media playback" section for
# the package list on distros that don't ship it out of the box.
#
# $APPDIR is exported automatically by the AppImage runtime when this file
# executes from inside a mounted/extracted AppImage. The fallback below
# lets this same script also work if AppRun is ever invoked directly from
# an unpacked AppDir (e.g. local testing before packaging).
HERE="${APPDIR:-$(cd "$(dirname "$(readlink -f "$0")")" && pwd)}"
exec "${HERE}/bin/DuckDash" "$@"
